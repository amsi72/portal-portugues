<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<meta name="description" content="Aula de Português 2: concordância verbal e nominal. Material de leitura do Seminário Presbiteriano de Brasília.">
<title>Português 2 — Concordância verbal e nominal</title>
<style>
:root{
  color-scheme:light;
  --bg:#eef2f7;--surface:#fff;--paper:#f8fafc;--ink:#1e293b;--muted:#475569;
  --navy:#0b2344;--navy-light:#163a6b;--blue:#2563eb;--blue-pale:#eff6ff;--blue-border:#bfdbfe;
  --teal:#0f766e;--teal-pale:#f0fdfa;--teal-border:#99f6e4;--green:#15803d;--green-pale:#f0fdf4;--green-border:#bbf7d0;
  --coral:#c2410c;--coral-pale:#fff7ed;--coral-border:#fed7aa;--purple:#6d28d9;--purple-pale:#f5f3ff;--purple-border:#ddd6fe;
  --amber:#b45309;--amber-pale:#fffbeb;--amber-border:#fde68a;--line:#cbd5e1;
  --shadow-sm:0 1px 3px rgba(11,35,68,.06);--shadow-md:0 4px 20px rgba(11,35,68,.10);
  --hdr-navy:#134a84;--hdr-teal:#10a386;--hdr-main:#1e293b;--hdr-sub:#334155;--hdr-line:#1e5a96;
}
html.dark-mode{
  color-scheme:dark;--bg:#090d16;--surface:#111827;--paper:#1e293b;--ink:#f1f5f9;--muted:#94a3b8;
  --navy:#e2e8f0;--navy-light:#93c5fd;--blue:#60a5fa;--blue-pale:#172554;--blue-border:#1e3a8a;
  --teal:#2dd4bf;--teal-pale:#042f2e;--teal-border:#115e59;--green:#4ade80;--green-pale:#052e16;--green-border:#14532d;
  --coral:#fb923c;--coral-pale:#431407;--coral-border:#7c2d12;--purple:#c084fc;--purple-pale:#2e1065;--purple-border:#581c87;
  --amber:#fbbf24;--amber-pale:#451a03;--amber-border:#78350f;--line:#334155;
  --shadow-sm:0 1px 3px rgba(0,0,0,.35);--shadow-md:0 6px 24px rgba(0,0,0,.45);
  --hdr-navy:#1d5ca0;--hdr-teal:#2dd4bf;--hdr-main:#f8fafc;--hdr-sub:#cbd5e1;--hdr-line:#3b82f6;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:24px}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.68;-webkit-font-smoothing:antialiased;overflow-x:hidden;transition:background-color .2s,color .2s}
.page-wrapper{width:min(100%,1060px);min-height:100vh;margin:0 auto;padding:26px clamp(15px,4.5vw,58px) 54px;background:var(--surface);box-shadow:var(--shadow-md);position:relative}
.inst-header{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:auto auto;align-items:center;column-gap:clamp(12px,2.4vw,28px);row-gap:10px;padding:0 0 15px;margin:0 auto 24px;border-bottom:2px solid var(--hdr-line);min-width:0}
.theme-switch-wrapper{grid-column:1/-1;grid-row:1;justify-self:end;align-self:start;margin:0 0 2px;z-index:5}
.theme-switch-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-width:48px;min-height:42px;padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--ink);cursor:pointer;box-shadow:var(--shadow-sm);font:inherit;touch-action:manipulation}
.theme-switch-btn:hover{border-color:var(--blue)}.theme-switch-btn:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
.theme-switch-btn svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.spb-brand-left{grid-column:1;grid-row:2;display:flex;align-items:center;gap:14px;min-width:0}
.spb-emblem-svg{width:72px;height:98px;flex:0 0 auto}
.spb-brand-text{min-width:0}.spb-brand-name{font-size:1.02rem;font-weight:750;line-height:1.12;color:var(--hdr-main)}
.spb-brand-motto{margin-top:5px;font-size:.73rem;line-height:1.3;color:var(--hdr-sub)}
.spb-meta-right{grid-column:2;grid-row:2;min-width:0;text-align:right;color:var(--hdr-main)}
.spb-meta-line{font-size:.83rem;line-height:1.5;font-weight:650;letter-spacing:.02em;overflow-wrap:anywhere}
.spb-meta-prof{margin-top:4px;font-size:.83rem;color:var(--hdr-sub)}
.slim-toc{position:fixed;left:14px;top:50%;transform:translateY(-50%);z-index:1100;width:36px;max-height:min(78vh,720px);overflow:hidden;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:8px 5px;box-shadow:var(--shadow-md);opacity:.86;transition:width .22s,border-radius .2s,padding .2s,opacity .2s}
.slim-toc:hover,.slim-toc:focus-within{width:258px;border-radius:13px;padding:10px 8px;opacity:1;overflow-y:auto}
.slim-toc-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px}
.slim-toc-link{display:flex;align-items:center;gap:9px;min-height:31px;padding:4px 6px;border-radius:8px;text-decoration:none;color:var(--muted);white-space:nowrap}
.slim-toc-link:hover,.slim-toc-link:focus-visible{background:var(--blue-pale);color:var(--blue);outline:none}
.slim-toc-link.active{background:var(--blue-pale);color:var(--blue);font-weight:800}
.toc-num{display:inline-flex;align-items:center;justify-content:center;flex:0 0 22px;width:22px;height:22px;border-radius:50%;background:var(--paper);font-size:.78rem;font-weight:800}
.toc-text{display:inline-block;opacity:0;max-width:0;overflow:hidden;font-size:.84rem;transition:max-width .2s,opacity .2s}
.slim-toc:hover .toc-text,.slim-toc:focus-within .toc-text{opacity:1;max-width:210px}
.hero-title-block{text-align:center;margin:0 auto 28px;padding:9px 0 23px;border-bottom:1px solid var(--line)}
.hero-kicker{color:var(--purple);font-size:.84rem;font-weight:900;letter-spacing:.14em;margin-bottom:9px}
.hero-title-block h1{margin:0 auto 9px;max-width:950px;font-size:clamp(1.9rem,4vw,2.8rem);line-height:1.16;color:var(--ink)}
.hero-subtitle{margin:0 auto;color:var(--muted);font-size:clamp(1rem,1.7vw,1.2rem);font-weight:650}
.back-portal-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:9px 16px;border-radius:999px;border:1px solid var(--blue-border);background:var(--blue-pale);color:var(--blue);text-decoration:none;font-size:.88rem;font-weight:800;line-height:1.35;touch-action:manipulation}
.back-portal-btn:hover{filter:brightness(.97)}
.content-sec{margin:0 0 30px;scroll-margin-top:24px}
.content-sec h2{margin:0 0 15px;padding:0 0 9px;border-bottom:2px solid var(--line);color:var(--navy);font-size:1.42rem;line-height:1.3}
.content-sec h3{margin:22px 0 9px;color:var(--navy-light);font-size:1.12rem;line-height:1.35}
.content-sec p{margin:0 0 13px;color:var(--ink);text-align:left}
.content-sec ul,.content-sec ol{margin:7px 0 15px;padding-left:1.45rem}
.content-sec li{margin:0 0 7px;padding-left:3px}
.lead-box{margin:0 0 24px;padding:17px 20px;border:1px solid var(--blue-border);border-left:5px solid var(--blue);border-radius:0 12px 12px 0;background:var(--blue-pale)}
.lead-box strong{display:block;margin-bottom:5px;color:var(--blue);font-size:.88rem;letter-spacing:.06em}
.example{margin:13px 0;padding:14px 17px;border:1px solid var(--line);border-radius:11px;background:var(--paper)}
.example-label{display:block;margin-bottom:5px;color:var(--blue);font-size:.88rem;font-weight:850}
.explain{margin:7px 0 0!important;color:var(--muted)!important;font-size:.97rem;font-style:italic}
.callout{margin:17px 0;padding:16px 18px;border:1px solid var(--teal-border);border-left:5px solid var(--teal);border-radius:0 11px 11px 0;background:var(--teal-pale)}
.callout-title{margin-bottom:7px;color:var(--teal);font-size:.9rem;font-weight:900;letter-spacing:.035em}
.callout p:last-child{margin-bottom:0}
.callout.blue{border-color:var(--blue-border);border-left-color:var(--blue);background:var(--blue-pale)}
.callout.orange{border-color:var(--coral-border);border-left-color:var(--coral);background:var(--coral-pale)}
.callout.purple{border-color:var(--purple-border);border-left-color:var(--purple);background:var(--purple-pale)}
.table-wrap{max-width:100%;overflow-x:auto;margin:14px 0 18px;border:1px solid var(--line);border-radius:11px;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;min-width:560px;background:var(--surface);font-size:.98rem}
th,td{padding:11px 13px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
th{background:var(--navy);color:#fff;font-size:.88rem;letter-spacing:.025em}
tbody tr:last-child td{border-bottom:0}tbody tr:nth-child(even){background:var(--paper)}
.term{display:inline-block;margin:2px 4px 2px 0;padding:2px 8px;border-radius:999px;background:var(--blue-pale);color:var(--blue);font-size:.88rem;font-weight:750}
.good{color:var(--green);font-weight:850}.bad{color:var(--coral);font-weight:850}
.step-list{counter-reset:steps;list-style:none!important;padding:0!important;margin:14px 0!important;display:grid;gap:9px}
.step-list li{counter-increment:steps;position:relative;padding:11px 14px 11px 48px;border:1px solid var(--line);border-radius:10px;background:var(--paper);margin:0}
.step-list li::before{content:counter(steps);position:absolute;left:13px;top:11px;width:25px;height:25px;display:grid;place-items:center;border-radius:50%;background:var(--blue);color:#fff;font-size:.83rem;font-weight:850}
.quick-summary{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;margin:14px 0}
.summary-item{padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:var(--paper)}
.summary-item strong{display:block;margin-bottom:3px;color:var(--blue);font-size:.92rem}
.back-portal-wrap{text-align:center;padding:27px 0 8px;margin-top:30px;border-top:1px solid var(--line)}
.site-credit{text-align:center;padding:18px 12px 25px}
.bunker-logo-link{display:inline-flex;align-items:center;justify-content:center;max-width:100%}
.bunker-logo-link img{display:block;width:min(145px,36vw);max-height:126px;height:auto;object-fit:contain}
.bunker-logo-link img.bunker-logo-light{display:none}
html.dark-mode .bunker-logo-dark{display:none}html.dark-mode .bunker-logo-light{display:block}
.footer-note{color:var(--muted);font-size:.84rem;margin-top:8px}
/* Modo leitura: remove a interface e apresenta o conteúdo em uma coluna limpa. */
.reader-toolbar{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap;margin:15px 0 28px}
.reader-toggle-btn,.reader-print-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:43px;padding:9px 16px;border:1px solid var(--blue-border);border-radius:999px;background:var(--blue-pale);color:var(--blue);font:inherit;font-size:.9rem;font-weight:750;cursor:pointer;touch-action:manipulation}
.reader-toggle-btn:hover,.reader-print-btn:hover{filter:brightness(.97)}
.reader-toggle-btn:focus-visible,.reader-print-btn:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
.reader-toolbar svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}
.reader-print-btn{display:none}
body.reader-mode{background:#fff!important;color:#20242a!important}
body.reader-mode .page-wrapper{width:min(100%,860px);min-height:0;margin:0 auto;padding:28px clamp(18px,5vw,54px) 54px;background:#fff!important;color:#20242a!important;box-shadow:none}
body.reader-mode .inst-header,body.reader-mode .slim-toc,body.reader-mode .back-portal-wrap,body.reader-mode .site-credit{display:none!important}
body.reader-mode .hero-title-block{text-align:left;margin:0 auto 14px;padding:0 0 17px;border-bottom:1px solid #d7dce2}
body.reader-mode .hero-kicker{color:#5b6470;font-size:.82rem;letter-spacing:.1em}
body.reader-mode .hero-title-block h1{margin:0 0 8px;color:#14181e;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2rem,4vw,2.6rem);line-height:1.2}
body.reader-mode .hero-subtitle{margin:0;color:#59616c;font-size:1.05rem;font-weight:500}
body.reader-mode .reader-toolbar{justify-content:flex-end;margin:0 0 30px;padding:0 0 13px;border-bottom:1px solid #e2e6eb}
body.reader-mode .reader-toggle-btn,body.reader-mode .reader-print-btn{background:#f5f7f9;border-color:#d8dee6;color:#28384c}
body.reader-mode .reader-print-btn{display:inline-flex}
body.reader-mode .content-sec{margin:0 0 30px;scroll-margin-top:12px}
body.reader-mode .content-sec h2{margin:0 0 15px;padding:0 0 8px;border-bottom:1px solid #cfd5dc;color:#172b45;font-family:Georgia,"Times New Roman",serif;font-size:1.48rem;line-height:1.35}
body.reader-mode .content-sec h3{margin:23px 0 10px;color:#263d59;font-family:Georgia,"Times New Roman",serif;font-size:1.2rem;line-height:1.4}
body.reader-mode .content-sec p,body.reader-mode .content-sec li{color:#20242a;font-size:1.08rem;line-height:1.85}
body.reader-mode .content-sec ul,body.reader-mode .content-sec ol{padding-left:1.5rem}
body.reader-mode .example,body.reader-mode .callout,body.reader-mode .lead-box,body.reader-mode .summary-item{padding:7px 0;margin:14px 0;background:transparent!important;border:0;border-radius:0;box-shadow:none}
body.reader-mode .callout-title,body.reader-mode .example-label{color:#344a63;font-size:.94rem;letter-spacing:0}
body.reader-mode .explain{color:#4b5563!important;font-size:1rem;font-style:normal}
body.reader-mode .term{padding:0;background:transparent;color:#243e5c;font-size:.98rem}
body.reader-mode .good,body.reader-mode .bad{color:#20242a!important}
body.reader-mode .quick-summary{gap:5px}
body.reader-mode .table-wrap{overflow:visible;border:0;border-radius:0}
body.reader-mode table{min-width:0;background:#fff;color:#20242a;font-size:1rem}
body.reader-mode th{background:#e9edf2;color:#1d2b3c;font-size:.92rem}
body.reader-mode td,body.reader-mode th{padding:9px 10px;border-bottom:1px solid #d9dee5}
body.reader-mode tbody tr:nth-child(even){background:#f8f9fa}
body.reader-mode .step-list li{padding:8px 8px 8px 44px;background:transparent;border:0}
body.reader-mode .back-portal-wrap,body.reader-mode .site-credit{display:none!important}

@media(max-width:900px){.slim-toc{left:6px;width:30px}.slim-toc:hover,.slim-toc:focus-within{width:230px}}
@media(max-width:640px){
 body{font-size:16px}.page-wrapper{padding:13px 14px 44px;box-shadow:none}
 .inst-header{grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto auto;row-gap:11px;padding-bottom:12px;margin-bottom:20px}
 .inst-header>.theme-switch-wrapper{grid-column:1;grid-row:1;justify-self:end;margin-right:0}
 .spb-brand-left{grid-column:1;grid-row:2;width:100%;gap:11px}.spb-meta-right{grid-column:1;grid-row:3;text-align:left;width:100%}
 .spb-emblem-svg{width:48px;height:66px}.spb-brand-name{font-size:1rem}.spb-brand-motto{font-size:.7rem}
 .spb-meta-line{font-size:.79rem}.spb-meta-prof{font-size:.81rem}
 .slim-toc{position:sticky;left:auto;top:auto;transform:none;width:100%;max-width:100%;max-height:none;height:auto;overflow-x:auto;overflow-y:hidden;margin:0 auto 18px;padding:6px 8px;border-radius:11px;opacity:1;box-shadow:var(--shadow-sm);-webkit-overflow-scrolling:touch}
 .slim-toc:hover,.slim-toc:focus-within{width:100%;padding:6px 8px;overflow-x:auto;overflow-y:hidden}
 .slim-toc-list{flex-direction:row;align-items:center;gap:5px;width:max-content;min-width:100%}.slim-toc-list li{flex:0 0 auto;margin:0}
 .slim-toc-link{min-height:34px;padding:5px 8px;gap:5px}.toc-num{width:20px;height:20px;flex-basis:20px}.toc-text{display:inline;opacity:1;max-width:155px;font-size:.75rem}
 .hero-title-block{padding:7px 2px 18px;margin-bottom:22px}.hero-title-block h1{font-size:clamp(1.65rem,7vw,2.15rem)}
 .content-sec h2{font-size:1.25rem}.content-sec h3{font-size:1.05rem}
 .lead-box,.callout,.example{padding:13px 14px}.quick-summary{grid-template-columns:1fr}
 .back-portal-btn{width:100%;min-height:44px}
}
@media(max-width:380px){.page-wrapper{padding-left:11px;padding-right:11px}.spb-brand-left{gap:8px}.spb-emblem-svg{width:43px;height:59px}.toc-text{max-width:125px}}
@media print{
  @page{margin:18mm 16mm}
  html,body{background:#fff!important;color:#111!important;font-size:11pt!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  body .page-wrapper,body.reader-mode .page-wrapper{width:100%;max-width:none;min-height:0;margin:0;padding:0;box-shadow:none;background:#fff!important;color:#111!important}
  .slim-toc,.theme-switch-wrapper,.reader-toolbar,.back-portal-wrap,.site-credit{display:none!important}
  .inst-header{margin-bottom:16px}
  .content-sec{break-inside:auto;page-break-inside:auto}
  .content-sec h2,.content-sec h3{break-after:avoid;page-break-after:avoid}
  .example,.callout,.lead-box,li,tr{break-inside:avoid;page-break-inside:avoid}
  .table-wrap{overflow:visible;border:0}
  table{min-width:0;font-size:9.5pt}
  th,td{padding:6px 7px}
  p,li{orphans:3;widows:3}
}
</style>
<script>
(function(){
  try { var saved=localStorage.getItem('spb_portais_tema'); if(saved==='dark') document.documentElement.classList.add('dark-mode'); }
  catch(e){}
})();
</script>
</head>
<body>
<nav class="slim-toc" aria-label="Sumário de navegação rápida">
  <ul class="slim-toc-list">
    <li><a class="slim-toc-link" href="#sec-concordancia"><span class="toc-num">1</span><span class="toc-text">O que é concordância?</span></a></li>
    <li><a class="slim-toc-link" href="#sec-verbal"><span class="toc-num">2</span><span class="toc-text">Concordância verbal</span></a></li>
    <li><a class="slim-toc-link" href="#sec-nominal"><span class="toc-num">3</span><span class="toc-text">Concordância nominal</span></a></li>
    <li><a class="slim-toc-link" href="#sec-aplicacao"><span class="toc-num">4</span><span class="toc-text">Aplicação bíblica e acadêmica</span></a></li>
    <li><a class="slim-toc-link" href="#sec-exercicios"><span class="toc-num">5</span><span class="toc-text">Exercícios de fixação</span></a></li>
    <li><a class="slim-toc-link" href="#sec-sintese"><span class="toc-num">6</span><span class="toc-text">Síntese para consulta</span></a></li>
  </ul>
</nav>
<main class="page-wrapper">
<header class="inst-header" role="banner" aria-label="Cabeçalho institucional do Seminário Presbiteriano de Brasília">
  <div class="theme-switch-wrapper">
    <button class="theme-switch-btn" id="themeToggle" type="button" role="switch" aria-checked="false" aria-label="Alternar para modo escuro" title="Alternar tema">
      <svg id="themeIcon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line></svg>
      <span id="themeLabel">Claro</span>
    </button>
  </div>
  <div class="spb-brand-left">
    <svg class="spb-emblem-svg" viewBox="0 0 120 164" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect fill="#134a84" x="0" y="0" width="120" height="128"></rect><rect fill="#fff" x="56" y="0" width="8" height="128"></rect><rect fill="#fff" x="0" y="48" width="120" height="8"></rect>
      <path d="M60 12 C26 32 26 84 60 106 C94 84 94 32 60 12Z" fill="#134a84" stroke="#fff" stroke-width="7.5" stroke-linejoin="round"></path><path d="M60 106 C46 113 35 116 28 117 M60 106 C74 113 85 116 92 117" fill="none" stroke="#fff" stroke-width="7.5" stroke-linecap="round"></path><circle cx="60" cy="36" r="4.2" fill="#fff"></circle>
      <rect x="0" y="124" width="120" height="40" fill="#fff"></rect><path d="M0 128 Q30 113 60 129 Q90 113 120 128 L120 137 Q90 122 60 138 Q30 122 0 137Z" fill="#10a386"></path><path d="M0 142 Q30 127 60 143 Q90 127 120 142 L120 151 Q90 136 60 152 Q30 136 0 151Z" fill="#10a386"></path><path d="M0 156 Q30 141 60 157 Q90 141 120 156 L120 164 L0 164Z" fill="#10a386"></path>
    </svg>
    <div class="spb-brand-text"><div class="spb-brand-name">Seminário<br>Presbiteriano<br>de Brasília</div><div class="spb-brand-motto">Teologia para transformação da vida</div></div>
  </div>
  <div class="spb-meta-right">
    <div class="spb-meta-line">BACHAREL EM TEOLOGIA</div>
    <div class="spb-meta-line">DEPARTAMENTO DE CULTURA GERAL</div>
    <div class="spb-meta-line">LÍNGUA PORTUGUESA — PORTUGUÊS 2 — 2º SEM. 2026</div>
    <div class="spb-meta-prof">Prof.: ISMAEL ROCHA</div>
  </div>
</header>

<div class="hero-title-block">
  <div class="hero-kicker">PORTUGUÊS 2 · UNIDADE 6</div>
  <h1>Concordância verbal e nominal</h1>
  <p class="hero-subtitle">Relações de harmonia gramatical na construção do período</p>
</div>

<div class="reader-toolbar" role="group" aria-label="Ferramentas de leitura">
  <button class="reader-toggle-btn" id="readerToggle" type="button" aria-pressed="false" aria-label="Ativar modo leitura">
