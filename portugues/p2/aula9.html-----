(function(){
  var root=document.documentElement,btn=document.getElementById('themeToggle'),icon=document.getElementById('themeIcon'),label=document.getElementById('themeLabel');
  var sun='<circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>';
  var moon='<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
  function sync(){var dark=root.classList.contains('dark-mode');icon.innerHTML=dark?moon:sun;label.textContent=dark?'Escuro':'Claro';btn.setAttribute('aria-checked',String(dark));btn.setAttribute('aria-label',dark?'Alternar para modo claro':'Alternar para modo escuro');}
  sync();btn.addEventListener('click',function(){root.classList.toggle('dark-mode');var mode=root.classList.contains('dark-mode')?'dark':'light';try{localStorage.setItem('spb_portais_tema',mode);}catch(e){}sync();});
  var readerToggle=document.getElementById('readerToggle');
  var readerToggleLabel=document.getElementById('readerToggleLabel');
  var readerPrint=document.getElementById('readerPrint');
  if(readerToggle){
    readerToggle.addEventListener('click',function(){
      var active=!document.body.classList.contains('reader-mode');
      document.body.classList.toggle('reader-mode',active);
      readerToggle.setAttribute('aria-pressed',String(active));
      readerToggle.setAttribute('aria-label',active?'Sair do modo leitura':'Ativar modo leitura');
      if(readerToggleLabel)readerToggleLabel.textContent=active?'Sair do modo leitura':'Modo leitura';
      if(active)window.scrollTo({top:0,behavior:'smooth'});
    });
  }
  if(readerPrint){readerPrint.addEventListener('click',function(){window.print();});}
  var sections=document.querySelectorAll('section.content-sec'),links=document.querySelectorAll('.slim-toc-link');
  function updateActive(){var pos=window.scrollY+145,current=sections[0]?sections[0].id:'';sections.forEach(function(s){if(s.offsetTop<=pos)current=s.id;});links.forEach(function(a){a.classList.toggle('active',a.getAttribute('href')==='#'+current);});}
  window.addEventListener('scroll',updateActive,{passive:true});updateActive();
})();
</script>
