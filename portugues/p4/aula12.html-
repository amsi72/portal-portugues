<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Português 4 — Aula 11: Gêneros Eclesiásticos e Redação Oficial</title>
  <style>
    :root {
      color-scheme: light;
      --bg-page: #eef2f7;
      --surface: #ffffff;
      --paper: #f8fafc;
      --ink: #1e293b;
      --muted: #475569;
      --navy: #0b2344;
      --navy-light: #163a6b;
      --blue: #2563eb;
      --blue-pale: #eff6ff;
      --blue-border: #bfdbfe;
      --teal: #0f766e;
      --teal-pale: #f0fdfa;
      --teal-border: #99f6e4;
      --green: #15803d;
      --green-pale: #f0fdf4;
      --green-border: #bbf7d0;
      --coral: #c2410c;
      --coral-pale: #fff7ed;
      --coral-border: #fed7aa;
      --purple: #6d28d9;
      --purple-pale: #f5f3ff;
      --purple-border: #ddd6fe;
      --amber: #b45309;
      --amber-pale: #fffbeb;
      --amber-border: #fde68a;
      --line: #cbd5e1;
      --shadow-sm: 0 1px 3px rgba(11, 35, 68, 0.06);
      --shadow-md: 0 4px 20px rgba(11, 35, 68, 0.1);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;

      /* Cores Vetoriais do Cabeçalho Institucional (Modo Claro) */
      --hdr-navy: #134a84;
      --hdr-teal: #10a386;
      --hdr-right-main: #1e293b;
      --hdr-right-sub: #334155;
      --hdr-line: #1e5a96;

      /* Pílulas sintáticas modo claro */
      --pill-op-bg: #dbeafe; --pill-op-txt: #1e3a8a; --pill-op-brd: #93c5fd;
      --pill-co-bg: #dcfce7; --pill-co-txt: #14532d; --pill-co-brd: #86efac;
      --pill-su-bg: #ffedd5; --pill-su-txt: #7c2d12; --pill-su-brd: #fdba74;
      --pill-cn-bg: #fae8ff; --pill-cn-txt: #581c87; --pill-cn-brd: #e879f9;
    }

    html.dark-mode {
      color-scheme: dark;
      --bg-page: #090d16;
      --surface: #111827;
      --paper: #1e293b;
      --ink: #f1f5f9;
      --muted: #94a3b8;
      --navy: #e2e8f0;
      --navy-light: #93c5fd;
      --blue: #60a5fa;
      --blue-pale: #172554;
      --blue-border: #1e3a8a;
      --teal: #2dd4bf;
      --teal-pale: #042f2e;
      --teal-border: #115e59;
      --green: #4ade80;
      --green-pale: #052e16;
      --green-border: #14532d;
      --coral: #fb923c;
      --coral-pale: #431407;
      --coral-border: #7c2d12;
      --purple: #c084fc;
      --purple-pale: #2e1065;
      --purple-border: #581c87;
      --amber: #fbbf24;
      --amber-pale: #451a03;
      --amber-border: #78350f;
      --line: #334155;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.35);
      --shadow-md: 0 6px 24px rgba(0, 0, 0, 0.55);

      /* Cores Vetoriais do Cabeçalho Institucional (Modo Escuro — integrado ao fundo) */
      --hdr-navy: #1d5ca0;
      --hdr-teal: #2dd4bf;
      --hdr-right-main: #f8fafc;
      --hdr-right-sub: #cbd5e1;
      --hdr-line: #3b82f6;

      /* Pílulas sintáticas modo escuro */
      --pill-op-bg: #1e3a8a; --pill-op-txt: #dbeafe; --pill-op-brd: #3b82f6;
      --pill-co-bg: #14532d; --pill-co-txt: #dcfce7; --pill-co-brd: #22c55e;
      --pill-su-bg: #7c2d12; --pill-su-txt: #ffedd5; --pill-su-brd: #f97316;
      --pill-cn-bg: #581c87; --pill-cn-txt: #fae8ff; --pill-cn-brd: #c084fc;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-page);
      color: var(--ink);
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 18px;
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .page-wrapper {
      max-width: 1060px;
      margin: 0 auto;
      background-color: var(--surface);
      padding: 28px clamp(16px, 4.5vw, 58px) 84px;
      box-shadow: var(--shadow-md);
      transition: background-color 0.2s ease;
    }

    /* Chave Seletora de Modo Claro / Escuro */
    .theme-switch-wrapper {
      position: fixed;
      top: 16px;
      right: 18px;
      z-index: 1200;
    }

    .theme-switch-btn {
      appearance: none;
      background-color: var(--surface);
      color: var(--ink);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 5px 10px 5px 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: inherit;
      font-size: 0.78rem;
      font-weight: 700;
      box-shadow: var(--shadow-md);
      transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.15s ease;
    }

    .theme-switch-btn:hover {
      border-color: var(--blue);
      transform: translateY(-1px);
    }

    .theme-switch-btn:focus-visible {
      outline: 2px solid var(--blue);
      outline-offset: 2px;
    }

    .switch-track {
      width: 30px;
      height: 17px;
      background-color: var(--line);
      border-radius: 999px;
      position: relative;
      transition: background-color 0.2s ease;
    }

    html.dark-mode .switch-track {
      background-color: var(--blue);
    }

    .switch-thumb {
      width: 13px;
      height: 13px;
      background-color: #ffffff;
      border-radius: 50%;
      position: absolute;
      top: 2px;
      left: 2px;
      transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 1px 2px rgba(0,0,0,0.25);
    }

    html.dark-mode .switch-thumb {
      transform: translateX(13px);
    }

    .theme-switch-btn svg {
      width: 15px;
      height: 15px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Menu Lateral Slim Fixo e Sóbrio */
    .slim-toc {
      position: fixed;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 1100;
      background-color: var(--surface);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 8px 5px;
      width: 36px;
      overflow: hidden;
      box-shadow: var(--shadow-md);
      opacity: 0.78;
      transition: width 0.24s cubic-bezier(0.4, 0, 0.2, 1), border-radius 0.2s ease, padding 0.2s ease, opacity 0.2s ease;
    }

    .slim-toc:hover,
    .slim-toc:focus-within {
      width: 254px;
      border-radius: var(--radius-md);
      padding: 10px 8px;
      opacity: 1;
    }

    .slim-toc-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .slim-toc-link {
      display: flex;
      align-items: center;
      gap: 9px;
      text-decoration: none;
      color: var(--muted);
      padding: 4px;
      border-radius: 999px;
      white-space: nowrap;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .slim-toc-link:hover,
    .slim-toc-link:focus-visible {
      background-color: var(--blue-pale);
      color: var(--blue);
      outline: none;
    }

    .slim-toc-link.active {
      background-color: var(--blue);
      color: #ffffff;
    }

    .toc-num {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      font-weight: 800;
      border-radius: 50%;
    }

    .toc-text {
      font-size: 0.8rem;
      font-weight: 600;
      opacity: 0;
      transition: opacity 0.18s ease;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .slim-toc:hover .toc-text,
    .slim-toc:focus-within .toc-text {
      opacity: 1;
    }

    /* CABEÇALHO INSTITUCIONAL ADAPTÁVEL AO FUNDO CLARO/ESCURO EM ALTA DEFINIÇÃO */
    .inst-header {
      width: 100%;
      margin: 0 auto 24px;
      background-color: transparent;
      padding: 4px 0 16px;
      border-bottom: 2.5px solid var(--hdr-line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      transition: border-color 0.2s ease;
    }

    .spb-brand-left {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-shrink: 0;
    }

    .spb-emblem-svg {
      width: 60px;
      height: 82px;
      display: block;
      flex-shrink: 0;
      border-radius: 3px;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    .spb-brand-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .spb-brand-name {
      font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      font-size: clamp(1.08rem, 1.9vw, 1.32rem);
      font-weight: 600;
      line-height: 1.16;
      color: #134a84;
      letter-spacing: -0.01em;
      transition: color 0.2s ease;
    }

    html.dark-mode .spb-brand-name {
      color: #e2e8f0;
    }

    .spb-brand-motto {
      font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      font-size: clamp(0.66rem, 1vw, 0.76rem);
      font-weight: 600;
      color: var(--hdr-teal);
      margin-top: 5px;
      letter-spacing: 0.01em;
    }

    .spb-meta-right {
      text-align: right;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 3px;
    }

    .spb-meta-line {
      font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      font-size: clamp(0.82rem, 1.45vw, 1.02rem);
      font-weight: 500;
      color: var(--hdr-right-sub);
      letter-spacing: 0.02em;
      line-height: 1.28;
      transition: color 0.2s ease;
    }

    /* Fonte suavizada para Prof.: ISMAEL ROCHA */
    .spb-meta-prof {
      font-family: "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
      font-size: clamp(0.86rem, 1.5vw, 1.04rem);
      font-weight: 500;
      color: var(--hdr-right-main);
      letter-spacing: 0.03em;
      margin-top: 2px;
      transition: color 0.2s ease;
    }

    /* Título Didático Principal */
    .hero-title-block {
      text-align: center;
      padding: 12px 10px 24px;
      margin-bottom: 30px;
      border-bottom: 2px solid var(--line);
    }

    .hero-title-block h1 {
      font-size: clamp(1.85rem, 4.5vw, 2.95rem);
      color: var(--navy);
      margin: 0 0 8px;
      letter-spacing: -0.02em;
      line-height: 1.15;
    }

    .hero-title-block .subtitle {
      font-size: clamp(1.05rem, 2.2vw, 1.38rem);
      color: var(--blue);
      font-weight: 600;
      margin: 0 0 16px;
    }
/* Seções e Tipografia */
    section.content-sec {
      margin-bottom: 46px;
      scroll-margin-top: 24px;
    }

    h2.sec-heading {
      font-size: clamp(1.35rem, 3vw, 1.85rem);
      color: var(--navy);
      border-bottom: 3px solid var(--blue);
      padding-bottom: 8px;
      margin: 0 0 18px;
      line-height: 1.25;
    }

    h3.sub-heading {
      font-size: clamp(1.12rem, 2.3vw, 1.35rem);
      color: var(--blue);
      margin: 26px 0 12px;
      line-height: 1.3;
    }

    p {
      margin: 0 0 15px;
    }

    ul, ol {
      margin: 0 0 18px;
      padding-left: 1.45rem;
    }

    li {
      margin-bottom: 8px;
    }

    strong {
      color: var(--navy);
      font-weight: 700;
    }

    /* Caixas de Destaque */
    .callout {
      border-left: 5px solid var(--teal);
      background-color: var(--teal-pale);
      border-top: 1px solid var(--teal-border);
      border-right: 1px solid var(--teal-border);
      border-bottom: 1px solid var(--teal-border);
      padding: 16px 20px;
      margin: 20px 0;
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
    }

    .callout.blue {
      border-left-color: var(--blue);
      background-color: var(--blue-pale);
      border-color: var(--blue-border);
    }

    .callout.coral {
      border-left-color: var(--coral);
      background-color: var(--coral-pale);
      border-color: var(--coral-border);
    }

    .callout.amber {
      border-left-color: var(--amber);
      background-color: var(--amber-pale);
      border-color: var(--amber-border);
    }

    .callout.green {
      border-left-color: var(--green);
      background-color: var(--green-pale);
      border-color: var(--green-border);
    }

    .callout-title {
      font-size: 0.96rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin: 0 0 6px;
      display: block;
      color: var(--navy);
    }

    /* Exemplos Fixos */
    .example-card {
      background-color: var(--paper);
      border: 1px solid var(--line);
      border-left: 5px solid var(--blue);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      padding: 15px 18px;
      margin: 16px 0;
    }

    .example-card.green {
      border-left-color: var(--green);
      background-color: var(--green-pale);
    }

    .example-tag {
      display: inline-block;
      font-size: 0.76rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 2px 9px;
      border-radius: 4px;
      background-color: var(--blue);
      color: #ffffff;
      margin-bottom: 8px;
    }

    .example-card.green .example-tag {
      background-color: var(--green);
    }

    .quote-verse {
      font-size: 1.06rem;
      font-weight: 700;
      color: var(--navy);
      margin-bottom: 8px;
    }

    /* Exemplos Interativos com Pequeno Ícone Clicável */
    .interactive-box {
      background-color: var(--surface);
      border: 1.5px solid var(--blue-border);
      border-radius: var(--radius-md);
      padding: 18px 20px;
      margin: 22px 0;
      box-shadow: var(--shadow-sm);
    }

    .interactive-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }

    .interactive-badge {
      background-color: var(--blue);
      color: #ffffff;
      font-size: 0.74rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 3px 10px;
      border-radius: 999px;
    }

    .interactive-focus {
      font-size: 0.86rem;
      color: var(--muted);
      font-weight: 600;
    }

    .interactive-prompt {
      font-size: 1.04rem;
      font-weight: 700;
      color: var(--navy);
      background-color: var(--paper);
      padding: 12px 15px;
      border-radius: var(--radius-sm);
      border-left: 4px solid var(--blue);
      margin-bottom: 12px;
    }

    .interactive-question-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .interactive-question {
      margin: 0;
      font-size: 0.95rem;
      color: var(--ink);
      flex: 1;
    }

    /* Pequeno Ícone Clicável para Resposta Comentada */
    .icon-answer-btn {
      appearance: none;
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      border-radius: 50%;
      background-color: var(--blue-pale);
      color: var(--blue);
      border: 1px solid var(--blue-border);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      transition: background-color 0.15s ease, color 0.15s ease, transform 0.2s ease, border-color 0.15s ease;
    }

    .icon-answer-btn:hover {
      background-color: var(--blue);
      color: #ffffff;
      border-color: var(--blue);
      transform: scale(1.08);
    }

    .icon-answer-btn:focus-visible {
      outline: 2px solid var(--amber);
      outline-offset: 2px;
    }

    .icon-answer-btn[aria-expanded="true"] {
      background-color: var(--teal);
      color: #ffffff;
      border-color: var(--teal);
    }

    .icon-answer-btn svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform 0.2s ease;
    }

    .icon-answer-btn[aria-expanded="true"] svg {
      transform: rotate(180deg);
    }

    .answer-panel {
      display: none;
      margin-top: 14px;
      padding: 15px 18px;
      background-color: var(--teal-pale);
      border: 1px solid var(--teal-border);
      border-left: 5px solid var(--teal);
      border-radius: var(--radius-sm);
      font-size: 0.94rem;
    }

    .answer-panel.is-open {
      display: block;
    }

    .answer-panel p:last-child {
      margin-bottom: 0;
    }

    /* Diagramas e Infográficos */
    .diagram-box {
      background-color: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 20px 18px;
      margin: 24px 0;
      box-shadow: var(--shadow-sm);
    }

    .diagram-title {
      text-align: center;
      font-size: 0.92rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--navy);
      margin: 0 0 18px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .diag-card {
      background-color: var(--surface);
      border: 1.5px solid var(--line);
      border-radius: var(--radius-md);
      padding: 16px;
    }

    .diag-card.coord { border-top: 5px solid var(--green); }
    .diag-card.subord { border-top: 5px solid var(--coral); }
    .diag-card.subst { border-top: 5px solid var(--blue); }
    .diag-card.adj { border-top: 5px solid var(--green); }

    .diag-card h4 {
      margin: 0 0 10px;
      font-size: 1.04rem;
      color: var(--navy);
    }

    .train-flow {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin: 12px 0;
    }

    .wagon {
      background-color: var(--green-pale);
      border: 1.5px solid var(--green);
      color: var(--navy);
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      font-size: 0.86rem;
      text-align: center;
    }

    .coupler {
      font-weight: 800;
      color: var(--coral);
      padding: 4px 8px;
      background-color: var(--coral-pale);
      border: 1px dashed var(--coral);
      border-radius: 6px;
      font-size: 0.8rem;
    }

    .tree-flow {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      margin: 12px 0;
    }

    .tree-root {
      background-color: var(--blue-pale);
      border: 1.5px solid var(--blue);
      color: var(--navy);
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      font-size: 0.86rem;
      text-align: center;
    }

    .tree-branch-arrow {
      font-size: 0.92rem;
      font-weight: 800;
      color: var(--coral);
    }

    .tree-leaf {
      background-color: var(--coral-pale);
      border: 1.5px solid var(--coral);
      color: var(--navy);
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      font-size: 0.86rem;
      text-align: center;
    }

    /* Marcadores Sintáticos Inline */
    .syn-pill {
      display: inline-block;
      padding: 2px 7px;
      border-radius: 5px;
      font-size: 0.85em;
      font-weight: 700;
      margin: 2px 1px;
    }

    .syn-op { background-color: var(--pill-op-bg); color: var(--pill-op-txt); border: 1px solid var(--pill-op-brd); }
    .syn-coord { background-color: var(--pill-co-bg); color: var(--pill-co-txt); border: 1px solid var(--pill-co-brd); }
    .syn-sub { background-color: var(--pill-su-bg); color: var(--pill-su-txt); border: 1px solid var(--pill-su-brd); }
    .syn-conn { background-color: var(--pill-cn-bg); color: var(--pill-cn-txt); border: 1px solid var(--pill-cn-brd); }

    /* Tabelas Responsivas */
    .table-wrap {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 20px 0 26px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
    }

    table {
      width: 100%;
      min-width: 540px;
      border-collapse: collapse;
      background-color: var(--surface);
      font-size: 0.93rem;
      line-height: 1.55;
    }

    thead th {
      background-color: #0b2344;
      color: #ffffff;
      font-weight: 700;
      text-align: left;
      padding: 12px 14px;
    }

    html.dark-mode thead th {
      background-color: #1e293b;
      color: #f8fafc;
      border-bottom: 2px solid var(--line);
    }

    td {
      padding: 11px 14px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
    }

    tbody tr:nth-child(even) {
      background-color: var(--paper);
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    /* Passo a Passo do Período Misto */
    .step-chain {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin: 18px 0;
    }

    .step-item {
      background-color: var(--surface);
      border: 1px solid var(--line);
      border-top: 4px solid var(--blue);
      border-radius: var(--radius-sm);
      padding: 13px 15px;
    }

    .step-num {
      display: inline-block;
      background-color: var(--blue-pale);
      color: var(--blue);
      font-weight: 800;
      font-size: 0.76rem;
      padding: 2px 8px;
      border-radius: 4px;
      margin-bottom: 6px;
    }

    /* Referências Gramaticais e Rodapé */
    .ref-footer {
      margin-top: 52px;
      padding-top: 22px;
      border-top: 2px solid var(--line);
      font-size: 0.88rem;
      color: var(--muted);
    }

    .ref-footer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 12px;
    }

    .ref-footer h3 {
      font-size: 0.95rem;
      color: var(--navy);
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .ref-footer ul {
      padding-left: 1.2rem;
      margin: 0;
    }

    /* Pequena Seta no Final da Página para Subir Rápido ao Topo */
    .bottom-actions-bar {
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px dashed var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .scroll-top-btn {
      appearance: none;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background-color: var(--paper);
      color: var(--navy);
      border: 1px solid var(--line);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      box-shadow: var(--shadow-sm);
      transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
    }

    .scroll-top-btn:hover,
    .scroll-top-btn:focus-visible {
      background-color: var(--blue);
      color: #ffffff;
      border-color: var(--blue);
      transform: translateY(-2px);
      outline: none;
    }

    .scroll-top-btn svg {
      width: 17px;
      height: 17px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2.3;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Compatibilidade Mobile e Telas Menores */
    @media (max-width: 1160px) {
      .slim-toc {
        left: 8px;
        width: 32px;
        padding: 6px 4px;
      }

      .toc-num {
        width: 17px;
        height: 17px;
        font-size: 0.7rem;
      }
    }

    @media (max-width: 768px) {
      .grid-2 {
        grid-template-columns: 1fr;
      }

      body {
        font-size: 16px;
        line-height: 1.62;
      }

      .page-wrapper {
        padding: 16px 14px 74px 44px;
      }

      .inst-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding-bottom: 14px;
      }

      .spb-meta-right {
        text-align: left;
      }

      .slim-toc {
        left: 5px;
        width: 28px;
        padding: 6px 3px;
        opacity: 0.88;
      }

      .slim-toc:hover,
      .slim-toc:focus-within {
        width: 225px;
        padding: 8px 6px;
      }

      .toc-num {
        width: 16px;
        height: 16px;
        font-size: 0.68rem;
      }

      .theme-switch-wrapper {
        top: 10px;
        right: 10px;
      }

      .theme-switch-btn {
        padding: 4px 8px;
        font-size: 0.72rem;
      }

      .interactive-box {
        padding: 14px 14px;
      }

      .interactive-prompt {
        font-size: 0.96rem;
        padding: 10px 12px;
      }

      .callout {
        padding: 14px 15px;
      }
    }

    @media print {
      body {
        background-color: #ffffff;
        font-size: 11.5pt;
      }
      .page-wrapper {
        box-shadow: none;
        max-width: none;
        padding: 0;
      }
      .slim-toc, .theme-switch-wrapper, .icon-answer-btn, .bottom-actions-bar {
        display: none !important;
      }
      .answer-panel {
        display: block !important;
      }
    }
  

/* === Padronização visual e responsividade === */


/* Chave junto ao cabeçalho no início do documento; rola para fora da tela */
.theme-switch-wrapper { position:absolute !important; top:14px !important; right:max(18px, calc((100vw - 1060px)/2 + 18px)) !important; z-index:1200; }
#themeToggle.theme-switch-btn { position:relative !important; top:auto !important; right:auto !important; z-index:1200; touch-action:manipulation; }
body { position:relative; }
html { scroll-padding-top:84px; }
body { overflow-x:clip; }
.page-wrapper { min-width:0; }
.page-wrapper img { max-width:100%; height:auto; }
@media (max-width:640px) {
  .theme-switch-wrapper { top:10px !important; right:12px !important; }
  #themeToggle.theme-switch-btn { min-width:44px; min-height:44px; }
  .page-wrapper { width:100%; padding-left:16px; padding-right:16px; }
  
}
@media print {
/* Cabeçalho de impressão em fluxo simples para evitar sobreposição em PDF. */
  .inst-header { display:block !important; min-height:100px; margin-bottom:16px !important; padding-bottom:10px !important; overflow:hidden; }
  .spb-brand-left { float:left; display:flex !important; width:43%; gap:10px !important; align-items:center; }
  .spb-emblem-svg { width:50px !important; height:68px !important; }
  .spb-brand-text { display:block !important; min-width:0; }
  .spb-brand-name { font-size:10.5pt !important; line-height:1.15 !important; }
  .spb-brand-motto { font-size:7pt !important; line-height:1.2 !important; margin-top:3px !important; }
  .spb-meta-right { float:right; display:block !important; width:54%; text-align:right; }
  .spb-meta-line, .spb-meta-prof { display:block !important; font-size:8pt !important; line-height:1.25 !important; margin:0 0 3px !important; letter-spacing:0 !important; }
  .inst-header::after { content:""; display:block; clear:both; }
}



/* Bunker Digital: arquivo original externo, com variante por tema */
.bunker-logo-link{display:inline-flex;align-items:center;justify-content:center;max-width:100%;}
.bunker-logo-link img{display:block;width:min(150px,42vw);height:auto;object-fit:contain;}
.bunker-logo-light{display:none!important;}
html.dark-mode .bunker-logo-dark,html[data-theme="dark"] .bunker-logo-dark{display:none!important;}
html.dark-mode .bunker-logo-light,html[data-theme="dark"] .bunker-logo-light{display:block!important;}




/* Modo leitura: apresentação limpa do conteúdo para leitura e impressão */
.reader-toolbar{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap;margin:14px auto 0;}
.reader-actions{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap;}
.reader-actions[hidden]{display:none!important;}
.reader-btn{appearance:none;border:1px solid var(--blue-border);background:var(--blue-pale);color:var(--blue);border-radius:999px;padding:9px 15px;min-height:42px;display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:inherit;font-size:.9rem;font-weight:600;line-height:1.2;cursor:pointer;transition:background-color .18s ease,color .18s ease,border-color .18s ease,transform .18s ease;}
.reader-btn:hover,.reader-btn:focus-visible{background:var(--blue);border-color:var(--blue);color:#fff;outline:none;transform:translateY(-1px);}
.reader-btn:focus-visible{outline:2px solid var(--amber);outline-offset:3px;}
.reader-btn svg{width:18px;height:18px;flex:0 0 18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
.reader-exit-btn{background:var(--surface);color:var(--muted);border-color:var(--line);}

/* Ampliação discreta das fontes auxiliares e dos rótulos pequenos */
.theme-switch-btn{font-size:.85rem;}
.toc-num{font-size:.8rem;}
.toc-text{font-size:.9rem;}
.spb-brand-motto{font-size:clamp(.74rem,1vw,.82rem);}
.spb-meta-line{font-size:clamp(.88rem,1.45vw,1.04rem);}
.spb-meta-prof{font-size:clamp(.9rem,1.5vw,1.06rem);}
.example-tag{font-size:.84rem;}
.interactive-badge{font-size:.82rem;}
.interactive-focus{font-size:.92rem;}
.diagram-title{font-size:.98rem;}
.wagon,.tree-root,.tree-leaf{font-size:.92rem;}
.coupler{font-size:.88rem;}
.step-num{font-size:.84rem;}
.ref-footer{font-size:.95rem;}
.ref-footer h3{font-size:1rem;}
table{font-size:.98rem;}
.syn-pill{font-size:.9em;}

/* Leitura limpa: mantém exemplos, diagramas e tabelas, retirando a interface */
body.reader-mode{background:#fff!important;color:#18212f!important;}
.reader-mode .page-wrapper{max-width:860px;background:#fff!important;color:#18212f!important;box-shadow:none!important;padding:30px clamp(18px,5vw,58px) 48px!important;}
.reader-mode .inst-header,.reader-mode .slim-toc,.reader-mode .theme-switch-wrapper,.reader-mode .site-credit,.reader-mode .portal-return-wrap{display:none!important;}
.reader-mode .hero-title-block{padding:4px 0 18px;margin-bottom:24px;border-bottom:1px solid #d6dce5;}
.reader-mode .hero-title-block h1{color:#111827!important;}
.reader-mode .hero-title-block .subtitle{color:#334155!important;}
.reader-mode .content-sec{margin-bottom:30px;}
.reader-mode .content-sec p,.reader-mode .content-sec li{font-size:1.08rem;line-height:1.78;color:#202938!important;}
.reader-mode .sec-heading{color:#10233f!important;border-bottom-color:#9aa9bb;}
.reader-mode .sub-heading,.reader-mode h3,.reader-mode h4{color:#1d3555!important;}
.reader-mode .callout,.reader-mode .example-card,.reader-mode .diagram-box,.reader-mode .diag-card,.reader-mode .step-item,.reader-mode .interactive-box{background:#fff!important;color:#202938!important;box-shadow:none!important;border-color:#d5dce5!important;break-inside:avoid;}
.reader-mode .callout p,.reader-mode .example-card p,.reader-mode .diag-card p,.reader-mode .step-item p,.reader-mode .interactive-box p{color:#202938!important;}
.reader-mode .callout-title,.reader-mode .diagram-title,.reader-mode .quote-verse{color:#18385f!important;}
.reader-mode blockquote{color:#283548!important;border-left-color:#8a9bb0!important;}
.reader-mode table{background:#fff!important;color:#202938!important;font-size:1rem;}
.reader-mode thead th{background:#e9eef5!important;color:#14243a!important;border-color:#ccd5e1!important;}
.reader-mode tbody tr:nth-child(even){background:#f7f9fc!important;}
.reader-mode td{color:#202938!important;border-color:#d8dee8!important;}
.reader-mode .syn-pill{print-color-adjust:exact;-webkit-print-color-adjust:exact;}
.reader-mode .reader-toolbar{margin:0 auto 24px;}
.reader-mode .reader-mode-btn{display:none!important;}
.reader-mode .reader-actions{display:flex!important;}
.reader-mode .reader-btn{background:#f1f5f9!important;color:#1d3555!important;border-color:#cbd5e1!important;}

.portal-return-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:8px 15px;border:1px solid var(--blue-border);border-radius:999px;background:var(--blue-pale);color:var(--blue);font-size:.9rem;font-weight:650;text-decoration:none;}
.portal-return-btn:hover,.portal-return-btn:focus-visible{background:var(--blue);border-color:var(--blue);color:#fff;outline:none;}

@media(max-width:640px){
  .reader-btn{min-height:44px;padding:10px 14px;font-size:.88rem;}
  .reader-mode .page-wrapper{padding:22px 18px 36px!important;}
  .reader-mode .content-sec p,.reader-mode .content-sec li{font-size:1.04rem;}
  .toc-num{font-size:.8rem;}
  .theme-switch-btn{font-size:.82rem;}
}

@media print{
  @page{margin:18mm 16mm;}
  html,body{background:#fff!important;color:#111!important;}
  body{font-size:12pt!important;line-height:1.55!important;}
  .page-wrapper{max-width:none!important;margin:0!important;padding:0!important;box-shadow:none!important;background:#fff!important;color:#111!important;}
  .inst-header,.slim-toc,.theme-switch-wrapper,.reader-toolbar,.site-credit,.portal-return-wrap,.bottom-actions-bar{display:none!important;}
  .hero-title-block{padding:0 0 12pt!important;margin:0 0 18pt!important;border-bottom:1px solid #bbb!important;}
  .hero-title-block h1{font-size:22pt!important;color:#111!important;}
  .hero-title-block .subtitle{font-size:13pt!important;color:#333!important;}
  .content-sec{margin:0 0 18pt!important;break-inside:auto;}
  .content-sec p,.content-sec li{font-size:11.5pt!important;line-height:1.5!important;color:#111!important;orphans:3;widows:3;}
  h2,h3,h4{break-after:avoid;}
  .callout,.example-card,.diagram-box,.diag-card,.step-item,.interactive-box,blockquote{break-inside:avoid;box-shadow:none!important;}
  .callout,.example-card,.diagram-box,.diag-card,.step-item,.interactive-box{background:#fff!important;color:#111!important;}
  .table-wrap{overflow:visible!important;box-shadow:none!important;}
  table{width:100%!important;min-width:0!important;font-size:9.5pt!important;}
  thead th{background:#e9eef5!important;color:#111!important;}
  td,th{color:#111!important;}
  .answer-panel{display:block!important;}
  a{color:inherit!important;text-decoration:none!important;}
  *{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
}


/* Blocos adicionais de exemplos para a revisão ampliada */
.examples-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:16px 0 22px}
.examples-grid .example-card{margin:0;height:100%}
.example-card .model-label{display:block;font-size:.9rem;font-weight:800;color:var(--blue);margin:2px 0 7px}
.example-card .analysis-line{padding-top:8px;margin-top:8px;border-top:1px dashed var(--line);font-size:.96rem;color:var(--muted)}
.model-block{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius-md);padding:18px 20px;margin:16px 0;}
.model-block h4{margin:0 0 10px;color:var(--navy);font-size:1.04rem}
.model-block p:last-child{margin-bottom:0}
.model-block .model-caption{font-size:.88rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;color:var(--blue);margin-bottom:8px}
.model-block .model-text{border-left:3px solid var(--blue);padding:10px 14px;margin:10px 0;background:var(--surface);border-radius:0 8px 8px 0}
.model-block .model-text p:last-child{margin-bottom:0}
.example-sequence{display:flex;align-items:stretch;gap:8px;flex-wrap:wrap;margin:14px 0}
.example-sequence span{flex:1 1 145px;padding:10px 12px;border:1px solid var(--line);background:var(--surface);border-radius:9px;text-align:center;font-weight:650}
.example-sequence b{display:block;color:var(--blue);font-size:.83rem;margin-bottom:4px}
.comparison-table{width:100%;border-collapse:collapse;margin:16px 0 22px;overflow:hidden;border-radius:10px}
.comparison-table th,.comparison-table td{padding:11px 13px;border:1px solid var(--line);text-align:left;vertical-align:top}
.comparison-table th{background:var(--blue-pale);color:var(--navy);font-weight:800}
.comparison-table td{background:var(--surface)}
.note-small{font-size:.94rem;color:var(--muted)}
@media(max-width:700px){.examples-grid{grid-template-columns:1fr}.comparison-table{display:block;overflow-x:auto;white-space:normal}}

</style>
</head>
<body>
<div class="theme-switch-wrapper">
    <button type="button" id="themeToggle" class="theme-switch-btn" role="switch" aria-checked="false" title="Alternar entre modo claro e escuro" aria-label="Alternar entre modo claro e escuro">
      <svg id="themeIcon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      <span class="switch-track"><span class="switch-thumb"></span></span>
    </button>
  </div>
  <nav class="slim-toc" aria-label="Sumário de navegação rápida"><ul class="slim-toc-list"><li><a href="#sec-transicao" class="slim-toc-link active" title="1. Finalidade e responsabilidade"><span class="toc-num">1</span><span class="toc-text">Finalidade e responsabilidade</span></a></li><li><a href="#sec-generos-eclesiasticos" class="slim-toc-link" title="2. Gêneros eclesiásticos"><span class="toc-num">2</span><span class="toc-text">Gêneros eclesiásticos</span></a></li><li><a href="#sec-redacao-oficial" class="slim-toc-link" title="3. Redação oficial"><span class="toc-num">3</span><span class="toc-text">Redação oficial</span></a></li><li><a href="#sec-relatorios-web" class="slim-toc-link" title="4. Relatórios e comunicação web"><span class="toc-num">4</span><span class="toc-text">Relatórios e comunicação web</span></a></li><li><a href="#sec-conclusao" class="slim-toc-link" title="5. Integração dos gêneros"><span class="toc-num">5</span><span class="toc-text">Integração dos gêneros</span></a></li></ul></nav>
<main class="page-wrapper">
<header class="inst-header" role="banner" aria-label="Cabeçalho Institucional do Seminário Presbiteriano de Brasília">
      <div class="spb-brand-left">
        <svg class="spb-emblem-svg" viewBox="0 0 120 164" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="0" y="0" width="120" height="128" fill="#134a84"/><rect x="56" y="0" width="8" height="128" fill="#ffffff"/><rect x="0" y="48" width="120" height="8" fill="#ffffff"/>
          <path d="M 60 12 C 26 32, 26 84, 60 106 C 94 84, 94 32, 60 12 Z" fill="#134a84" stroke="#ffffff" stroke-width="7.5" stroke-linejoin="round"/><path d="M 60 106 C 46 113, 35 116, 28 117 M 60 106 C 74 113, 85 116, 92 117" fill="none" stroke="#ffffff" stroke-width="7.5" stroke-linecap="round"/><circle cx="60" cy="36" r="4.2" fill="#ffffff"/><rect x="0" y="124" width="120" height="40" fill="#ffffff"/><path d="M 0 128 Q 30 113, 60 129 Q 90 113, 120 128 L 120 137 Q 90 122, 60 138 Q 30 122, 0 137 Z" fill="#10a386"/><path d="M 0 142 Q 30 127, 60 143 Q 90 127, 120 142 L 120 151 Q 90 136, 60 152 Q 30 136, 0 151 Z" fill="#10a386"/><path d="M 0 156 Q 30 141, 60 157 Q 90 141, 120 156 L 120 164 L 0 164 Z" fill="#10a386"/>
        </svg>
        <div class="spb-brand-text"><div class="spb-brand-name">Seminário<br>Presbiteriano<br>de Brasília</div><div class="spb-brand-motto">Teologia para transformação da vida</div></div>
      </div>
      <div class="spb-meta-right"><div class="spb-meta-line">BACHAREL EM TEOLOGIA</div><div class="spb-meta-line">DEPARTAMENTO DE CULTURA GERAL</div><div class="spb-meta-line">LÍNGUA PORTUGUESA — PORTUGUÊS 4 — 2º SEM. 2026</div><div class="spb-meta-prof">Prof.: ISMAEL ROCHA</div></div>
    </header>
<div class="hero-title-block"><h1>Revisão Geral — Parte 2</h1><p class="subtitle">Unidades 3 e 4 · Gêneros Eclesiásticos, Redação Oficial e Comunicação Digital</p></div>
<div class="reader-toolbar" role="group" aria-label="Ferramentas de leitura">
  <button type="button" class="reader-btn reader-mode-btn" id="readerToggle" aria-pressed="false">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 5.5v16M8 7h8M8 11h8M8 15h5"/></svg>
    <span>Modo leitura</span>
  </button>
  <div class="reader-actions" id="readerActions" hidden>
    <button type="button" class="reader-btn reader-print-btn" id="readerPrintBtn">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"/><path d="M7 14h10v7H7zM17 11h.01"/></svg>
      <span>Imprimir / Salvar PDF</span>
    </button>
    <button type="button" class="reader-btn reader-exit-btn" id="readerExitBtn">Sair do modo leitura</button>
  </div>
</div>
<section class="content-sec" id="sec-transicao"><h2 class="sec-heading">1. Comunicação eclesiástica: finalidade, público e responsabilidade</h2>
<p>A comunicação institucional da igreja precisa adequar a linguagem à finalidade de cada documento e ao público a que se dirige. Um editorial de boletim procura orientar e encorajar a comunidade; um estudo bíblico organiza a exposição e a aplicação das Escrituras; uma ata registra deliberações; um ofício estabelece comunicação administrativa; um relatório presta contas de atividades e recursos.</p>
<p>Esses gêneros não são intercambiáveis. O tom acolhedor de uma mensagem pastoral não substitui a precisão de um registro conciliar, assim como a formalidade de um ofício não é a linguagem mais adequada para um editorial dirigido à membresia.</p>
<div class="callout blue"><span class="callout-title">Três critérios comuns</span><p><strong>Clareza:</strong> o leitor deve compreender o assunto e a informação principal.</p><p><strong>Adequação:</strong> o tom, a estrutura e o vocabulário devem corresponder à situação comunicativa.</p><p><strong>Responsabilidade:</strong> datas, decisões, informações e afirmações devem ser verificáveis e apresentados com precisão.</p></div>
</section>
<section class="content-sec" id="sec-generos-eclesiasticos"><h2 class="sec-heading">2. Unidade 3: Gêneros eclesiásticos e pastorais</h2>
<h3 class="sub-heading">2.1 Boletins e editoriais — a voz pastoral</h3>
<p>O boletim dominical reúne informações de interesse da comunidade e pode incluir um editorial ou mensagem pastoral. O editorial não é um tratado acadêmico nem um documento burocrático: é um texto breve de reflexão, aconselhamento e exortação, escrito para pessoas concretas e situações da vida comunitária.</p>
<p>Seu tom pode ser próximo e acolhedor, com vocativos como “Amados irmãos”, mas deve preservar sobriedade, correção linguística e conteúdo coerente com a finalidade pastoral.</p>
<div class="example-card"><span class="example-tag">Modelo 1 · Editorial pastoral</span><h4>Tema: comunhão e cuidado mútuo</h4><div class="model-text"><p>“Amados irmãos, a vida cristã não se desenvolve de maneira isolada. Somos chamados a caminhar em comunhão, sustentando uns aos outros em oração e serviço. Nesta semana, procuremos perceber as necessidades de quem está ao nosso redor e demonstrar, por atitudes concretas, o cuidado que aprendemos nas Escrituras.”</p></div><p class="analysis-line"><strong>Características:</strong> vocativo acolhedor, reflexão central e exortação prática.</p></div>
<div class="examples-grid">
 <div class="example-card"><span class="example-tag">Modelo 2 · Editorial de encorajamento</span><h4>Tema: perseverança</h4><p>“Amada igreja, os períodos de dificuldade também nos convidam a renovar a confiança no Senhor. A perseverança cristã não significa ausência de lutas, mas fidelidade no caminho, sustentada pela Palavra e pela comunhão dos irmãos. Que nossas reuniões sejam oportunidades de fortalecer os cansados e acolher os que precisam de apoio.”</p><p class="analysis-line"><strong>Ênfase:</strong> proximidade pastoral e encorajamento.</p></div>
 <div class="example-card"><span class="example-tag">Modelo 3 · Aviso de boletim</span><h4>Informação objetiva</h4><p>“A reunião de oração será realizada na quarta-feira, às dezenove horas, no salão principal. Toda a comunidade está convidada. Ao final, haverá um breve momento de comunhão.”</p><p class="analysis-line"><strong>Ênfase:</strong> informação direta sobre atividade, horário e local.</p></div>
</div>
<div class="callout coral"><span class="callout-title">Diferença entre editorial e aviso</span><p>O <strong>editorial</strong> desenvolve uma reflexão pastoral e pode exortar a comunidade. O <strong>aviso</strong> comunica informações práticas. Um boletim pode conter ambos, mas cada texto deve cumprir sua finalidade sem misturar reflexão longa com instruções operacionais.</p></div>
<h3 class="sub-heading">2.2 Estudos e mensagens bíblicas</h3>
<p>O estudo bíblico exige organização para que o leitor ou ouvinte compreenda o texto, acompanhe o desenvolvimento da doutrina e reconheça sua aplicação. Uma estrutura útil reúne três movimentos: <strong>exegese</strong>, <strong>doutrina</strong> e <strong>aplicação</strong>.</p>
<div class="step-chain">
 <div class="step-item"><span class="step-num">1 · Exegese</span><p>Investiga o sentido do texto em seu contexto original: destinatários, situação, contexto literário e desenvolvimento da passagem.</p></div>
 <div class="step-item"><span class="step-num">2 · Doutrina</span><p>Formula o princípio teológico que pode ser extraído do texto, respeitando o que a passagem efetivamente ensina.</p></div>
 <div class="step-item"><span class="step-num">3 · Aplicação</span><p>Relaciona o princípio à vida da comunidade, indicando implicações concretas sem se afastar do sentido do texto.</p></div>
</div>
<div class="example-card"><span class="example-tag">Modelo comentado 1</span><h4>Estudo bíblico sobre o Salmo 23</h4><p><strong>Exegese:</strong> observar a imagem do Senhor como pastor, a linguagem de cuidado e direção e o percurso do salmo, inclusive a passagem por situações de segurança e perigo.</p><p><strong>Doutrina:</strong> o texto apresenta o cuidado e a direção do Senhor como fundamento da confiança do seu povo.</p><p><strong>Aplicação:</strong> a comunidade é encorajada a confiar no cuidado divino e a exercer cuidado mútuo, especialmente em períodos de vulnerabilidade.</p><p class="analysis-line">A sequência parte do texto, formula o princípio e só então apresenta implicações para a vida.</p></div>
<div class="examples-grid">
 <div class="example-card"><span class="example-tag">Modelo comentado 2</span><h4>Estudo sobre Atos 2.42–47</h4><p><strong>Exegese:</strong> observar as práticas comunitárias descritas no relato: ensino, comunhão, partir do pão e orações.</p><p><strong>Doutrina:</strong> a vida da igreja envolve perseverança na instrução, comunhão e culto.</p><p><strong>Aplicação:</strong> refletir sobre como essas dimensões aparecem na vida comunitária atual.</p></div>
 <div class="example-card"><span class="example-tag">Modelo comentado 3</span><h4>Mensagem sobre Mateus 5.13–16</h4><p><strong>Exegese:</strong> considerar as imagens do sal e da luz no contexto do ensino de Jesus aos discípulos.</p><p><strong>Doutrina:</strong> o testemunho dos discípulos deve tornar visíveis as boas obras e apontar para a glória do Pai.</p><p><strong>Aplicação:</strong> relacionar o testemunho cristão às atitudes cotidianas, sem reduzir a passagem a uma busca por reconhecimento pessoal.</p></div>
</div>
<div class="callout green"><span class="callout-title">Equilíbrio necessário</span><p>Um estudo que apresenta apenas contexto e explicação pode ficar sem ligação com a vida da comunidade. Uma mensagem que salta diretamente para conselhos, sem examinar o texto, corre o risco de se tornar moralista. A articulação entre exegese, doutrina e aplicação ajuda a preservar o vínculo entre interpretação e prática.</p></div>
</section>
<section class="content-sec" id="sec-redacao-oficial"><h2 class="sec-heading">3. Unidade 4: O rigor da redação oficial na IPB</h2>
<p>A redação oficial exige impessoalidade, clareza, precisão e respeito às convenções do gênero. No contexto do governo colegiado presbiteriano, os registros formais preservam a memória institucional e podem ter relevância administrativa e civil. A forma do documento deve ajudar o leitor a identificar quem comunica, a quem se dirige, qual é o assunto e qual providência ou registro está sendo apresentado.</p>
<h3 class="sub-heading">3.1 A ata conciliar — registro das deliberações</h3>
<p>A ata registra formalmente o que ocorreu em uma reunião e preserva a memória das deliberações. Deve apresentar os dados necessários para identificar a reunião, registrar os assuntos tratados e documentar as decisões. No padrão de redação apresentado no material, a ata é lavrada em texto contínuo, com preenchimento das linhas, sem rasuras ou corretivo; datas, horários e quantias são grafados por extenso. O texto deve ser fiel ao que efetivamente aconteceu, sem opiniões pessoais do redator.</p>
<div class="callout blue"><span class="callout-title">Elementos usuais de uma ata</span><p>Identificação do órgão reunido; data, horário e local; indicação de quem presidiu e secretariou; registro dos assuntos e deliberações; encerramento; assinaturas correspondentes.</p></div>
<div class="example-card"><span class="example-tag">Modelo 1 · Abertura de ata</span><div class="model-text"><p>“Aos vinte e sete dias do mês de outubro do ano de dois mil e vinte e seis, às dezenove horas e trinta minutos, reuniu-se o Conselho da Igreja Presbiteriana [nome], em sua sede, sob a presidência do Reverendo [nome], estando presentes os presbíteros [nomes], conforme registro de presença.”</p></div><p class="analysis-line"><strong>Observe:</strong> a abertura identifica data, horário, órgão, local, presidência e presença.</p></div>
<div class="example-card"><span class="example-tag">Modelo 2 · Registro de deliberação</span><div class="model-text"><p>“Após exame da proposta apresentada pela Junta Diaconal, o Conselho deliberou aprovar a realização da campanha de arrecadação de alimentos no mês de novembro, ficando a comissão responsável pela organização e pela apresentação do relatório na reunião subsequente.”</p></div><p class="analysis-line"><strong>Observe:</strong> o texto registra o assunto, a decisão e a responsabilidade atribuída, sem comentários pessoais.</p></div>
<div class="example-card"><span class="example-tag">Modelo 3 · Encerramento</span><div class="model-text"><p>“Nada mais havendo a tratar, o presidente encerrou a reunião, e eu, [nome], secretário, lavrei a presente ata, que, depois de lida e aprovada, será assinada pelos responsáveis.”</p></div><p class="analysis-line"><strong>Observe:</strong> o encerramento informa o término e o procedimento de leitura, aprovação e assinatura.</p></div>
<h4 class="sub-heading">Mecanismos de retificação</h4>
<p>Quando um lapso é percebido durante a redação, o procedimento indicado no material é registrar a correção sem rasuras ou corretivo. Se o erro é identificado no próprio momento, emprega-se “digo”. Se é percebido após o encerramento do texto, utiliza-se a fórmula “Em tempo”, antes das assinaturas.</p>
<div class="examples-grid">
 <div class="example-card"><span class="example-tag">Correção no momento</span><p>“O Conselho aprovou a despesa de dois mil, digo, de três mil reais.”</p><p class="analysis-line">A retificação é feita imediatamente após a informação incorreta.</p></div>
 <div class="example-card"><span class="example-tag">Correção ao final</span><p>“Em tempo: onde se lê ‘dois mil reais’, leia-se ‘três mil reais’.”</p><p class="analysis-line">A anotação registra a correção depois do texto, antes das assinaturas.</p></div>
</div>
<h3 class="sub-heading">3.2 A carta de transferência e o ofício</h3>
<h4 class="sub-heading">Carta eclesiástica de transferência</h4>
<p>A carta de transferência é uma correspondência entre igrejas e concílios, destinada a apresentar formalmente a situação de um membro que passa a integrar outra comunidade. Conforme o conteúdo de referência, especialmente a carta de transferência tratada no Art. 18 da CI/IPB, ela atesta a comunhão, a conduta moral e a fidelidade do membro aos Símbolos de Westminster. Deve ser respeitosa, clara e cuidadosa, utilizando apenas informações verificadas.</p>
<div class="example-card"><span class="example-tag">Modelo 1 · Estrutura de carta</span><div class="model-text"><p><strong>IGREJA PRESBITERIANA [NOME]</strong><br>[Cidade], [data].</p><p>À Igreja Presbiteriana [destinatária]<br>Assunto: Carta de transferência de membro</p><p>Prezado Conselho,</p><p>Comunicamos que o irmão [nome completo], membro desta comunidade, solicitou transferência para essa igreja. Encaminhamos a presente carta para os procedimentos eclesiásticos cabíveis, com as informações constantes nos registros desta comunidade.</p><p>Fraternalmente em Cristo,<br>[Nome e função]<br>[Igreja]</p></div><p class="note-small">Modelo ilustrativo. A emissão deve refletir os registros efetivos e os procedimentos eclesiásticos aplicáveis.</p></div>
<div class="examples-grid">
 <div class="example-card"><span class="example-tag">Formulação adequada</span><p>“Encaminhamos a documentação do membro acima identificado para conhecimento e providências desse Conselho.”</p><p class="analysis-line">Comunicação respeitosa e objetiva, sem informalidade.</p></div>
 <div class="example-card"><span class="example-tag">Fecho característico</span><p>“Fraternalmente em Cristo,” seguido da identificação e da assinatura do responsável.</p><p class="analysis-line">O fecho expressa a natureza eclesiástica da correspondência.</p></div>
</div>
<h4 class="sub-heading">Ofício</h4>
<p>O ofício é um documento formal de comunicação, geralmente dirigido a autoridades, órgãos ou instituições. Pode encaminhar documentos, solicitar providências, apresentar informações ou comunicar decisões. Sua redação deve ser direta e organizada, com identificação do expediente, destinatário, assunto, corpo e fecho.</p>
<div class="example-card"><span class="example-tag">Modelo 2 · Ofício de encaminhamento</span><div class="model-text"><p><strong>OFÍCIO Nº 012/2026 — CONSELHO</strong><br>[Cidade], [data].</p><p>Ao Senhor [nome]<br>[Cargo / órgão]</p><p><strong>Assunto:</strong> Encaminhamento de relatório administrativo</p><p>Senhor [cargo ou tratamento],</p><p>Encaminhamos, para conhecimento e providências cabíveis, o relatório referente às atividades desenvolvidas por esta comunidade no período de [período]. Permanecemos à disposição para prestar os esclarecimentos necessários.</p><p>Atenciosamente,<br>[Nome]<br>[Cargo / instituição]</p></div><p class="note-small">A numeração e os dados do destinatário devem corresponder ao expediente real. No padrão descrito no material, “Respeitosamente” pode ser utilizado para autoridade superior e “Atenciosamente” para destinatário de nível equivalente.</p></div>
<div class="example-card"><span class="example-tag">Modelo 3 · Solicitação a órgão público</span><p><strong>Assunto:</strong> Solicitação de informação sobre uso de espaço público.</p><p>“Solicitamos a esse órgão orientação quanto aos procedimentos necessários para a utilização do espaço público [identificação], na data de [data], para a realização de atividade comunitária.”</p><p class="analysis-line">A finalidade aparece logo no assunto e é retomada no primeiro parágrafo.</p></div>
<h3 class="sub-heading">3.3 O requerimento — a petição formal</h3>
<p>O requerimento é o documento por meio do qual uma pessoa formaliza um pedido a uma autoridade ou órgão competente. No contexto eclesiástico apresentado, o membro em plena comunhão pode peticionar ao concílio. Sua estrutura reúne a qualificação do requerente, a exposição dos motivos, o pedido específico e a fórmula de encerramento.</p>
<div class="step-chain">
 <div class="step-item"><span class="step-num">1 · Qualificação</span><p>Nome completo e dados necessários para identificar o requerente e sua relação com o órgão.</p></div>
 <div class="step-item"><span class="step-num">2 · Justificativa</span><p>Exposição objetiva dos motivos que fundamentam o pedido.</p></div>
 <div class="step-item"><span class="step-num">3 · Pedido</span><p>Formulação clara da providência solicitada, sem deixar a decisão implícita.</p></div>
 <div class="step-item"><span class="step-num">4 · Fecho</span><p>Local, data, assinatura e fórmula “Nestes termos, pede deferimento”.</p></div>
</div>
<div class="example-card"><span class="example-tag">Modelo completo · Solicitação de uso de salão</span><div class="model-text"><p><strong>AO CONSELHO DA IGREJA PRESBITERIANA [NOME]</strong></p><p>Eu, [nome completo], membro desta comunidade, venho respeitosamente requerer autorização para utilizar o salão anexo da igreja no dia [data], das [horário] às [horário], para a realização de um evento beneficente.</p><p>O evento tem por finalidade [descrever brevemente o propósito]. Comprometo-me a observar as orientações da administração da igreja, zelar pelas instalações e entregar o espaço organizado após sua utilização.</p><p>Diante do exposto, solicito a apreciação do pedido pelo Conselho.</p><p>Nestes termos,<br>Pede deferimento.</p><p>[Cidade], [data].<br>[Assinatura]<br>[Nome completo]</p></div></div>
<div class="example-card"><span class="example-tag">Exemplo de pedido objetivo</span><p>“Requer a autorização para utilização da sala de reuniões no dia [data], das [hora] às [hora], para encontro de planejamento da equipe de ação social.”</p><p class="analysis-line">O pedido identifica providência, local, data, horário e finalidade.</p></div>
</section>
<section class="content-sec" id="sec-relatorios-web"><h2 class="sec-heading">4. Relatórios técnicos e comunicação na web</h2>
<h3 class="sub-heading">4.1 O relatório administrativo</h3>
<p>O relatório não é um diário de reunião. Enquanto a ata registra deliberações ocorridas em determinado encontro, o relatório consolida atividades realizadas ao longo de um período, apresenta dados, registra dificuldades e oferece elementos para prestação de contas e planejamento. Como instrumento de mordomia cristã, contribui para a transparência na administração de responsabilidades e recursos.</p>
<div class="examples-grid">
 <div class="callout coral"><span class="callout-title">Formulação imprecisa</span><p>“Gastamos pouco com a atividade e tivemos uma participação muito boa.”</p><p><strong>Limite:</strong> as expressões “pouco” e “muito boa” são vagas e não permitem conferência objetiva.</p></div>
 <div class="callout green"><span class="callout-title">Formulação mensurável</span><p>“A atividade contou com cinquenta e duas pessoas. Foram utilizados mil e duzentos reais em materiais e alimentação, conforme comprovantes anexos.”</p><p><strong>Vantagem:</strong> informa quantidade, valor e possibilidade de comprovação.</p></div>
</div>
<div class="example-card"><span class="example-tag">Modelo de relatório resumido</span><h4>Relatório de atividade comunitária</h4><p><strong>Período:</strong> [mês/ano].</p><p><strong>Finalidade:</strong> registrar a execução da ação comunitária organizada pela equipe responsável.</p><p><strong>Atividades realizadas:</strong> planejamento, divulgação, aquisição de materiais, atendimento às famílias e organização do espaço.</p><p><strong>Dados de execução:</strong> [quantidade] participantes; [quantidade] famílias atendidas; despesas de R$ [valor], conforme documentos comprobatórios.</p><p><strong>Resultados e dificuldades:</strong> [descrever resultados observados e dificuldades efetivamente registradas].</p><p><strong>Encaminhamentos:</strong> [indicar providências recomendadas, responsáveis e prazos].</p><p class="note-small">Os campos entre colchetes devem ser preenchidos com dados reais; não devem ser substituídos por estimativas apresentadas como fatos.</p></div>
<div class="example-card"><span class="example-tag">Comparação de linguagem</span><p><strong>Vago:</strong> “A campanha arrecadou bastante alimento.”</p><p><strong>Preciso:</strong> “A campanha arrecadou cento e oitenta quilos de alimentos não perecíveis, distribuídos a vinte e quatro famílias.”</p><p><strong>Vago:</strong> “A reforma avançou bem.”</p><p><strong>Preciso:</strong> “No período, foram concluídas a pintura do salão e a substituição de duas portas; a instalação elétrica permaneceu pendente.”</p><p><strong>Prestação financeira:</strong> “O superávit do período perfez o montante de três mil reais”, acompanhado dos demonstrativos e comprovantes correspondentes.</p></div>
<h3 class="sub-heading">4.2 Redação digital e escaneabilidade</h3>
<p>Na comunicação digital, o leitor geralmente consulta a tela em busca rápida das informações principais. A técnica da <strong>pirâmide invertida</strong> recomenda apresentar primeiro o dado mais importante — o que acontecerá, quando, onde e a quem se destina — e deixar explicações complementares para depois.</p>
<div class="example-card"><span class="example-tag">Modelo · Pirâmide invertida</span><h4>Comunicado de atividade</h4><div class="model-text"><p><strong>Informação principal:</strong> “A reunião de orientação para voluntários será realizada no sábado, [data], às [hora], na sala [local].”</p><p><strong>Complemento:</strong> “O encontro apresentará a organização das equipes, as tarefas previstas e os procedimentos de atendimento. Os participantes devem confirmar presença até [prazo].”</p></div><p class="analysis-line">A informação essencial aparece primeiro; os detalhes ampliam o entendimento sem esconder o objetivo.</p></div>
<div class="examples-grid">
 <div class="example-card"><span class="example-tag">Modelo · Instagram</span><h4>Publicação de evento</h4><div class="model-text"><p><strong>ENCONTRO DE ESTUDO BÍBLICO</strong><br>📅 [dia e data] · ⏰ [horário]<br>📍 [local]</p><p>Uma oportunidade de aprender as Escrituras, compartilhar dúvidas e crescer em comunhão. A atividade é aberta a [público].</p><p>Mais informações: [contato institucional].</p></div><p class="analysis-line">O título e os dados práticos aparecem no início; o contexto vem em seguida.</p></div>
 <div class="example-card"><span class="example-tag">Modelo · WhatsApp</span><h4>Aviso para a membresia</h4><div class="model-text"><p>📢 <strong>AVISO IMPORTANTE</strong></p><p>Informamos que a atividade de [nome] prevista para [dia/data], às [horário], foi [suspensa/transferida] em razão de [motivo confirmado].</p><p>A programação será retomada em [informação, se confirmada]. Pedimos que compartilhem este aviso com os irmãos que não acompanham o grupo.</p><p>Atenciosamente,<br>[Secretaria / Conselho]</p></div><p class="analysis-line">A mudança da programação é comunicada logo no início, com motivo e orientação.</p></div>
</div>
<div class="example-card"><span class="example-tag">Modelo · E-mail institucional</span><h4>Encaminhamento de documento</h4><div class="model-text"><p><strong>Assunto:</strong> Encaminhamento do relatório mensal — [mês/ano]</p><p>Prezados irmãos,</p><p>Encaminhamos, em anexo, o relatório das atividades realizadas no período de [mês/ano], para conhecimento e apreciação.</p><p>O documento reúne as ações executadas, os dados de participação, os recursos utilizados e os encaminhamentos propostos.</p><p>Atenciosamente,<br>[Nome e função]</p></div></div>
<div class="callout blue"><span class="callout-title">Escaneabilidade e correção linguística</span><p>Use parágrafos curtos, títulos informativos, listas quando houver itens, destaque moderado para datas e horários e espaçamento entre blocos. A concisão não autoriza abreviações excessivas, erros de pontuação ou abandono da norma-padrão em comunicações institucionais.</p></div>
</section>
<section class="content-sec" id="sec-conclusao"><h2 class="sec-heading">5. Integração: finalidade, gênero e linguagem</h2>
<p>A comunicação eclesiástica exige escolher a forma adequada para cada situação. O documento deve ser suficientemente formal para cumprir sua função, mas não precisa adotar o mesmo tom em todos os contextos.</p>
<table class="comparison-table"><thead><tr><th>Necessidade comunicativa</th><th>Gênero adequado</th><th>Característica principal</th></tr></thead><tbody>
<tr><td>Orientar e encorajar a comunidade.</td><td>Editorial ou mensagem pastoral.</td><td>Tom acolhedor, reflexão e exortação.</td></tr>
<tr><td>Ensinar uma passagem bíblica.</td><td>Estudo ou mensagem bíblica.</td><td>Exegese, doutrina e aplicação.</td></tr>
<tr><td>Registrar decisões de reunião.</td><td>Ata.</td><td>Fidelidade aos fatos e às deliberações.</td></tr>
<tr><td>Comunicar-se formalmente com outra instituição.</td><td>Ofício.</td><td>Identificação, assunto e pedido ou informação objetiva.</td></tr>
<tr><td>Apresentar uma solicitação a um órgão.</td><td>Requerimento.</td><td>Qualificação, justificativa e pedido claro.</td></tr>
<tr><td>Informar a execução de atividades e recursos.</td><td>Relatório.</td><td>Dados verificáveis, resultados e encaminhamentos.</td></tr>
<tr><td>Divulgar avisos e atividades em meios digitais.</td><td>Comunicado, postagem ou mensagem.</td><td>Informação principal no início e leitura rápida.</td></tr>
</tbody></table>
<div class="callout green"><span class="callout-title">Princípio de encerramento</span><p>A boa redação eclesiástica une conteúdo, forma e finalidade. A escolha correta do gênero, a organização das informações e o cuidado com a linguagem tornam a comunicação mais clara, confiável e adequada ao serviço da comunidade.</p></div>
</section>
</main>
<div class="portal-return-wrap" style="display:flex;justify-content:center;padding:22px 16px 36px;position:relative;z-index:1"><a href="/portugues/p4/" class="portal-return-btn" style="text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:8px" aria-label="Voltar ao portal de Português 4">← Voltar ao portal de Português 4</a></div>
  <script>
  (function(){'use strict';var root=document.documentElement,themeBtn=document.getElementById('themeToggle'),themeIcon=document.getElementById('themeIcon'),storageKey='spb-portugues4-theme';
  var sunSvg='<circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>',moonSvg='<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
  function applyTheme(mode){var dark=mode==='dark';root.classList.toggle('dark-mode',dark);themeBtn.setAttribute('aria-checked',String(dark));themeIcon.innerHTML=dark?moonSvg:sunSvg;}
  try{var saved=localStorage.getItem(storageKey);if(saved==='dark'||saved==='light')applyTheme(saved);}catch(e){}
  themeBtn.addEventListener('click',function(){var next=root.classList.contains('dark-mode')?'light':'dark';applyTheme(next);try{localStorage.setItem(storageKey,next);}catch(e){}});
  var scrollTopBtn=document.getElementById('scrollTopBtn');if(scrollTopBtn)scrollTopBtn.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});
  
  var readerToggle=document.getElementById('readerToggle');
  var readerActions=document.getElementById('readerActions');
  var readerPrintBtn=document.getElementById('readerPrintBtn');
  var readerExitBtn=document.getElementById('readerExitBtn');
  function setReaderMode(active){
    document.body.classList.toggle('reader-mode',active);
    if(readerActions) readerActions.hidden=!active;
    if(readerToggle){readerToggle.setAttribute('aria-pressed',String(active));}
    if(active){window.scrollTo({top:0,behavior:'smooth'});}
  }
  if(readerToggle) readerToggle.addEventListener('click',function(){setReaderMode(true);});
  if(readerExitBtn) readerExitBtn.addEventListener('click',function(){setReaderMode(false);});
  if(readerPrintBtn) readerPrintBtn.addEventListener('click',function(){window.print();});
  window.addEventListener('afterprint',function(){/* Mantém o modo escolhido pelo leitor. */});
  
  var sections=document.querySelectorAll('section.content-sec'),links=document.querySelectorAll('.slim-toc-link');function updateActiveNav(){var pos=window.scrollY+150,current=sections[0]?sections[0].id:'';sections.forEach(function(sec){if(sec.offsetTop<=pos)current=sec.id;});links.forEach(function(link){link.classList.toggle('active',link.getAttribute('href').slice(1)===current);});}window.addEventListener('scroll',updateActiveNav,{passive:true});updateActiveNav();
  })();
  </script>
<footer class="site-credit" style="text-align:center;padding:28px 16px 34px;position:relative;z-index:1"><a class="bunker-logo-link" href="https://bunkerdigital.top/" target="_blank" rel="noopener noreferrer" aria-label="Bunker Digital"><img class="bunker-logo-dark" src="/graphics/logo-bunker-dark.png" alt="Bunker Digital" loading="lazy"><img class="bunker-logo-light" src="/graphics/logo-bunker-light.png" alt="Bunker Digital" loading="lazy"></a></footer>
